root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Respect PowerShell conventions and here-string content.
[*.{ps1,psd1}]
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = false

# Machine-read or generated sources retain their original representation.
[{handwriting-data.js,study-posts.js,database/**,articles/**}]
trim_trailing_whitespace = false
