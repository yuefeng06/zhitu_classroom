# npm start / npm run db:migrate 自动读取项目根目录 .env
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 在本机 .env 填写，不要提交或发送密码。有特殊字符时使用双引号。
MYSQL_PASSWORD=""
MYSQL_DATABASE=zhitu_classroom
PORT=3000
# SQLite 迁移源；仅 DB_CLIENT=sqlite 时也作为运行数据库
# DB_PATH=./zhitu.db

# 可选：按章节覆盖视频源
# MEDIA_CONFIG_PATH=./media-sources.json

# 可选：头像图片存储目录；默认项目下 data/avatars，备份时与数据库一并保存
# AVATAR_DIR=./data/avatars

# 可选：离线推荐模型（含用户隐向量，必须保持私有）；训练后重启服务加载
# RECOMMENDATION_MODEL_PATH=./data/recommendations/model.json
